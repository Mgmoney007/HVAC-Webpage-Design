{
  "source": "https://ajperri.ars.com/HVAC",
  "brand": "A&C Quality Air",
  "extracted": "2026-11-05",
  "themeMode": "mixed",
  "notes": "Values marked (css) come from the page's inline stylesheets or Firecrawl branding output. Values marked (est) were measured by eye from the full-page screenshot and should be verified against the live page in devtools.",
  "light": {
    "colors": {
      "--color-primaty": "#243DAE",
      "--c-red": "#E4002B",
      "--c-blue-band": "#0058A3",
      "--c-navy-ink": "#0B2744",
      "--c-ice": "#F0F8FF",
      "--c-grey-bg": "#F4F4F4",
      "--c-white": "#FFFFFF",
      "--c-text": "#231F20",
      "--c-placeholder": "#5D5D5D",
      "--c-link": "#E4002B"
    },
    "typography": {
      "--font-sans": "Roboto, system-ui, -apple-system, 'Segoe UI', Arial, sans-serif",
      "--fs-h1": "48px",
      "--fs-h2": "36px",
      "--fs-body": "14px",
      "--fs-small": "12px",
      "--fw-regular": "400",
      "--fw-medium": "500",
      "--fw-bold": "700"
    },
    "spacing": {
      "--space-unit": "4px",
      "--container-max": "1188px",
      "--radius-input": "3px",
      "--radius-btn": "40px",
      "--radius-card": "8px"
    },
    "breakpoints": {
      "mobile-max": "767px",
      "tablet-max": "1024px",
      "desktop-min": "1025px",
      "wide-cap": "1188px"
    },
    "motion": {},
    "shadows": {
      "--shadow-card": "0 2px 8px rgba(0,0,0,0.15)"
    },
    "zIndex": {}
  },
  "dark": {
    "colors": {
      "--c-footer-bg": "#231F20",
      "--c-guarantee-bg": "#243DAE",
      "--c-footer-text": "#FFFFFF"
    }
  },
  "loadBearingRules": [
    { "selector": ".btn-primary", "declarations": "background:#E4002B; color:#fff; border:1px solid #E4002B; border-radius:40px; font-weight:700;" },
    { "selector": ".btn-secondary", "declarations": "background:transparent; color:#231F20; border:1px solid #E4002B; border-radius:40px;" },
    { "selector": "input, select", "declarations": "background:#fff; color:#000; border:1px solid #0B2744; border-radius:3px; box-shadow:none;" }
  ]
}
